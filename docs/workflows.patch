diff --git a/.github/workflows/keepalive.yml b/.github/workflows/keepalive.yml
new file mode 100644
index 0000000..bac63cc
--- /dev/null
+++ b/.github/workflows/keepalive.yml
@@ -0,0 +1,20 @@
+# Free Render instances sleep after 15 minutes idle and take ~30 s to wake,
+# which members see as a hung "Checking your sign-in". Pinging the health
+# endpoint every 10 minutes keeps it warm at zero cost.
+name: keepalive
+on:
+  schedule:
+    - cron: "*/10 * * * *"
+  workflow_dispatch:
+jobs:
+  ping:
+    runs-on: ubuntu-latest
+    steps:
+      - name: ping /healthz
+        run: |
+          set -e
+          for url in "${{ vars.KEEPALIVE_URLS || 'https://kalamboard-7go2.onrender.com/healthz' }}"; do
+            for u in ${url//,/ }; do
+              curl -fsS -m 40 "$u" && echo " ok $u" || echo " miss $u"
+            done
+          done
