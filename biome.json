{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "backend/src/**",
      "backend/tests/**",
      "frontend/src/**",
      "frontend/tests/**",
      "shared/src/**",
      "scripts/**",
      "!**/routeTree.gen.ts",
      "!**/*.css",
      "!**/*.json"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "useImportType": "warn",
        "useConst": "error"
      },
      "complexity": {
        "useLiteralKeys": "off",
        "useOptionalChain": "warn",
        "useMathMinMax": "off",
        "useIndexOf": "warn",
        "noUselessEscapeInRegex": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": {
          "level": "warn",
          "options": {
            "reportUnnecessaryDependencies": false
          }
        },
        "noUnusedVariables": "warn",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noExplicitAny": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      },
      "a11y": {
        "useSemanticElements": "warn",
        "noStaticElementInteractions": "warn",
        "useKeyWithClickEvents": "warn",
        "noLabelWithoutControl": {
          "level": "warn",
          "options": {
            "inputComponents": [
              "Input",
              "Select",
              "Switch",
              "Textarea"
            ]
          }
        },
        "useAriaPropsSupportedByRole": "warn",
        "noSvgWithoutTitle": "warn",
        "noNoninteractiveTabindex": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.test.ts",
        "**/tests/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnsafeOptionalChaining": "off",
            "noComponentHookFactories": "off"
          },
          "suspicious": {
            "noNonNullAssertedOptionalChain": "off",
            "useIterableCallbackReturn": "off"
          }
        }
      }
    }
  ]
}
