# InkBoard site — copy to frontend/.env for local dev.

# Dev server bind. The sandbox needs 0.0.0.0 to be reachable through a tunnel.
INKBOARD_WEB_HOST=127.0.0.1
INKBOARD_WEB_PORT=5173

# Where the Vite dev/preview server forwards /api, /healthz and /readyz.
INKBOARD_API=http://127.0.0.1:8787

# Production (Vercel / Nitro server): origin of the deployed API, scheme and
# host only. middleware.ts proxies to it and stamps INKBOARD_PROXY_SECRET.
INKBOARD_API_ORIGIN=
INKBOARD_PROXY_SECRET=

# Accounts are handled by the API (admin creates members). No frontend auth settings.
