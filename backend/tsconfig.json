{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "types": ["node"],
    "allowJs": true,
    "paths": {
      "@/*": ["./src/*"],
      "@inkboard/shared/*": ["../shared/src/lib/*"]
    }
  },
  "include": ["src", "tests"]
}
