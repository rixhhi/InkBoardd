# InkBoard API — copy to backend/.env. Every value is optional; the API runs
# with in-memory fallbacks when the stores are unset.

# Bind address. Use 0.0.0.0 inside a container.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8787

# Postgres mirrors jobs and caches upstream catalog responses. Leave blank to
# run without it (caches live in memory, jobs are rebuilt from JOB_DIR).
DATABASE_URL=

# Redis holds shared rate-limit counters and the timeline cache. Leave blank to
# use per-process memory.
REDIS_URL=

# Where enhance jobs write HLS/poster/sprite artifacts. Needs disk space.
JOB_DIR=/tmp/inkboard-jobs

# Keys saved-lecture job ids (HMAC). Leave blank: a random secret is written to
# JOB_DIR/.job-secret on first run. Pin it if JOB_DIR is wiped between deploys
# or several API processes share one JOB_DIR.
JOB_ID_SECRET=

# Path to ffmpeg if it is not on PATH. 1–4 concurrent encodes.
FFMPEG_PATH=
FFMPEG_CONCURRENCY=1

# Rate limiting (per visitor, per window). See README for the bucket rules.
RATE_LIMIT=120
RATE_WINDOW_MS=60000

# Proxy trust. Unset = ignore X-Forwarded-For. 1 = one hop. 2 = two hops but
# only when x-inkboard-proxy-secret matches INKBOARD_PROXY_SECRET.
TRUST_PROXY=
INKBOARD_PROXY_SECRET=

# Extra browser origins allowed by CORS (comma separated). Localhost ports
# 3000, 5173 and 8080 are always allowed.
CORS_ORIGINS=

# Optional xAI key for revision bullets in POST /api/study/summary.
XAI_API_KEY=
XAI_MODEL=

LOG_LEVEL=info
