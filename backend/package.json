{
  "name": "@inkboard/backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "echo 'Node 22 runs TypeScript natively; no build step needed.'",
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=../.env --experimental-strip-types --import ./register.mjs src/server.ts",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=../.env --experimental-strip-types --import ./register.mjs src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --import ./register.mjs --test --test-force-exit 'src/**/*.test.ts' 'tests/**/*.test.ts' 'tests/**/*.test.mjs'"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@fastify/compress": "^9.3.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@inkboard/shared": "*",
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.0"
  }
}
